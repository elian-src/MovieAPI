<%- include('../partials/header') %>

<div class="glass" style="padding: 2.5rem; border-radius: 16px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h2 style="font-size: 2rem;">Gestión de Géneros</h2>
  </div>

  <div id="alert-container" class="glass" style="display: none; padding: 1rem; margin-bottom: 2rem;">
    <span id="alert-message"></span>
  </div>

  <div style="display: flex; gap: 2rem; align-items: flex-start; flex-wrap: wrap;">
    
    <!-- Formulario Nuevo Genero -->
    <div class="glass" style="flex: 1; min-width: 300px; padding: 1.5rem;">
      <h3 style="margin-bottom: 1.5rem;">Agregar Género</h3>
      <form id="form-genero">
        <div class="form-group">
          <label class="form-label">Nombre del Género *</label>
          <input type="text" id="nombre-genero" class="form-control" required placeholder="Ej. Ciencia Ficción">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          <i data-lucide="plus"></i> Guardar
        </button>
      </form>
    </div>

    <!-- Lista de Generos -->
    <div class="glass" style="flex: 2; min-width: 400px; padding: 1.5rem; overflow-x: auto;">
      <h3 style="margin-bottom: 1.5rem;">Géneros Existentes</h3>
      <% if (generos.length === 0) { %>
        <p style="color: var(--text-muted); text-align: center; padding: 2rem;">No hay géneros registrados.</p>
      <% } else { %>
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nombre</th>
              <th style="text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% generos.forEach(g => { %>
              <tr>
                <td><%= g.id %></td>
                <td><%= g.nombre %></td>
                <td>
                  <div class="table-actions" style="justify-content: flex-end;">
                    <button onclick="eliminarGenero(<%= g.id %>)" class="btn btn-danger btn-icon" title="Eliminar">
                      <i data-lucide="trash-2" style="width: 18px; height: 18px;"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  function showAlert(message, isError = false) {
    const alertContainer = document.getElementById('alert-container');
    const alertMessage = document.getElementById('alert-message');
    
    alertContainer.style.display = 'block';
    alertContainer.style.backgroundColor = isError ? 'rgba(239, 68, 68, 0.2)' : 'rgba(16, 185, 129, 0.2)';
    alertContainer.style.borderColor = isError ? 'var(--danger-color)' : 'var(--success-color)';
    alertContainer.style.color = isError ? '#fca5a5' : '#6ee7b7';
    alertMessage.textContent = message;

    setTimeout(() => {
      alertContainer.style.display = 'none';
    }, 5000);
  }

  document.getElementById('form-genero').addEventListener('submit', async (e) => {
    e.preventDefault();
    const nombre = document.getElementById('nombre-genero').value;
    
    try {
      await axios.post('/api/generos', { nombre });
      window.location.reload();
    } catch (error) {
      const msg = error.response?.data?.message || error.response?.data?.errors?.[0]?.msg || 'Error al crear género';
      showAlert(msg, true);
    }
  });

  async function eliminarGenero(id) {
    if (confirm('¿Estás seguro de eliminar este género? No se podrá si tiene títulos asociados.')) {
      try {
        await axios.delete(`/api/generos/${id}`);
        window.location.reload();
      } catch (error) {
        const msg = error.response?.data?.message || 'Error al eliminar género';
        showAlert(msg, true);
      }
    }
  }
</script>

<%- include('../partials/footer') %>
