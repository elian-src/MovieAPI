<%- include('partials/header') %>

<div class="glass form-container">
  <h2 style="margin-bottom: 2rem; font-size: 2rem;">Editar Título</h2>
  
  <div id="error-alert" class="glass" style="display: none; background: rgba(239, 68, 68, 0.2); border-color: var(--danger-color); padding: 1rem; margin-bottom: 2rem; color: #fca5a5;">
    <ul id="error-list" style="list-style-type: disc; padding-left: 1.5rem;"></ul>
  </div>

  <form id="form-editar">
    <div class="form-group">
      <label class="form-label">Nombre *</label>
      <input type="text" name="nombre" class="form-control" value="<%= titulo.nombre %>" required>
    </div>

    <div class="form-group" style="display: flex; gap: 1rem;">
      <div style="flex: 1;">
        <label class="form-label">Tipo *</label>
        <select name="tipo" class="form-control" required>
          <option value="pelicula" <%= titulo.tipo === 'pelicula' ? 'selected' : '' %>>Película</option>
          <option value="serie" <%= titulo.tipo === 'serie' ? 'selected' : '' %>>Serie</option>
        </select>
      </div>
      <div style="flex: 1;">
        <label class="form-label">Género *</label>
        <select name="generoId" class="form-control" required>
          <% generos.forEach(g => { %>
            <option value="<%= g.id %>" <%= titulo.generoId === g.id ? 'selected' : '' %>><%= g.nombre %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Descripción</label>
      <textarea name="descripcion" class="form-control" rows="4"><%= titulo.descripcion %></textarea>
    </div>

    <div class="form-group" style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 120px;">
        <label class="form-label">Año *</label>
        <input type="number" name="anio" class="form-control" value="<%= titulo.anio %>" required min="1800" max="2100">
      </div>
      <div style="flex: 1; min-width: 120px;">
        <label class="form-label">Duración</label>
        <input type="number" name="duracion" class="form-control" value="<%= titulo.duracion %>" placeholder="Min o Eps">
      </div>
      <div style="flex: 1; min-width: 120px;">
        <label class="form-label">Puntuación (1-10)</label>
        <input type="number" name="puntuacion" class="form-control" step="0.1" min="1" max="10" value="<%= titulo.puntuacion %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Director / Creador</label>
      <input type="text" name="director" class="form-control" value="<%= titulo.director %>">
    </div>

    <div class="form-actions">
      <a href="/detalle/<%= titulo.id %>" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        <i data-lucide="save"></i> Guardar Cambios
      </button>
    </div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  document.getElementById('form-editar').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    
    // Clean empty values
    Object.keys(data).forEach(key => {
      if (data[key] === '') {
        data[key] = null;
      }
    });

    try {
      await axios.put('/api/titulos/<%= titulo.id %>', data);
      window.location.href = '/detalle/<%= titulo.id %>';
    } catch (error) {
      const errorAlert = document.getElementById('error-alert');
      const errorList = document.getElementById('error-list');
      errorList.innerHTML = '';
      
      if (error.response && error.response.data.errors) {
        error.response.data.errors.forEach(err => {
          const li = document.createElement('li');
          li.textContent = err.msg;
          errorList.appendChild(li);
        });
      } else if (error.response && error.response.data.message) {
        const li = document.createElement('li');
        li.textContent = error.response.data.message;
        errorList.appendChild(li);
      } else {
        const li = document.createElement('li');
        li.textContent = 'Error al actualizar el título';
        errorList.appendChild(li);
      }
      
      errorAlert.style.display = 'block';
      window.scrollTo(0, 0);
    }
  });
</script>

<%- include('partials/footer') %>
